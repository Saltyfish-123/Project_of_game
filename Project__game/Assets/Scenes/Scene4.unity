  m_Name: 
  m_EditorClassIdentifier: 
  dialogueStrings:
  - text: "\u6211\u5BB6\u5B85\u9662\u65B0\u4FEE\uFF0C\u524D\u5EAD\u4E8C\u95E8\u8FDF\u8FDF\u672A\u5B9A\uFF0C\u5BB6\u4E2D\u89C4\u77E9\u8BB2\u7A76\u5185\u5916\u6709\u522B\uFF0C\u9700\u5F97\u4E00\u4EF6\u4F53\u9762\u7269\u4EF6\u505A\u9694\u65AD\uFF0C\u52B3\u70E6\u4E2D\u4ECB\u5C0F\u54E5\u5E2E\u6211\u7504\u9009\u4E00\u4E8C\u3002"
    isEnd: 0
    isQuestion: 0
    answerOptiong1: 
    answerOptiong2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u6211\u8981\u7684\u5E76\u975E\u89C2\u666F\u7EB3\u51C9\u7684\u4EAD\u53F0\uFF0C\u800C\u662F\u5782\u82B1\u95E8\u3002\u6B64\u95E8\u4E3A\u5B85\u9662\u4E8C\u95E8\u7CBE\u9AD3\uFF0C\u95E8\u6A90\u5782\u82B1\u67F1\u96D5\u82B1\u7CBE\u81F4\uFF0C\u6731\u6F06\u63CF\u91D1\uFF0C\u65E2\u906E\u9662\u5185\u666F\u81F4\uFF0C\u5B88\u5185\u5916\u793C\u5236\uFF0C\u53C8\u663E\u4E16\u5BB6\u6C14\u5EA6\uFF0C\u662F\u5B85\u9662\u5FC5\u4E0D\u53EF\u5C11\u7684\u95E8\u9762\uFF0C\u7EDD\u975E\u516D\u89D2\u4EAD\u8FD9\u7C7B\u95F2\u7528\u4E4B\u7269\u53EF\u6BD4\u3002"
    isEnd: 0
    isQuestion: 0
    answerOptiong1: 
    answerOptiong2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
