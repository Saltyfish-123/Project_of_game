--- !u!114 &877624447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 877624446}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22f17a85cd38974439f2fa99df54eb2e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Object_s:
  - id: 1
    group: 1
    object_inform:
      name: "\u516D\u89D2\u91CD\u4EAD"
      description: "\u516D\u89D2\u4EAD\u662F\u4E2D\u56FD\u4F20\u7EDF\u56ED\u6797\u4E2D\u5E38\u89C1\u7684\u5355\u6A90\u516D\u89D2\u5F62\u4EAD\u5F0F\u5EFA\u7B51,\u901A\u5E38\u4EE5\u6728\u3001\u77F3\u7B49\u6750\u6599\u6784\u5EFA,\u9020\u578B\u8F7B\u76C8\u7075\u5DE7,\u5360\u5730\u9762\u79EF\u8F83\u5C0F.\u5176\u4E3B\u8981\u529F\u80FD\u662F\u4E3A\u6E38\u4EBA\u63D0\u4F9B\u906E\u9633\u907F\u96E8\u3001\u4F11\u61A9\u9A7B\u8DB3\u7684\u573A\u6240,\u5E38\u70B9\u7F00\u4E8E\u56ED\u6797\u666F\u81F4\u4E4B\u4E2D,\u4E0E\u82B1\u8349\u3001\u5C71\u77F3\u3001\u6C34\u4F53\u7B49\u642D\u914D,\u589E\u6DFB\u56ED\u6797\u7684\u96C5\u81F4\u6C1B\u56F4,\u662F\u517C\u5177\u5B9E\u7528\u6027\u4E0E\u89C2\u8D4F\u6027\u7684\u5C0F\u578B\u5EFA\u7B51\u5C0F\u54C1."
      image: {fileID: 21300000, guid: a430125f0e3d35648922d2cc85d04b75, type: 3}
  - id: 2
    group: 1
    object_inform:
      name: "\u5317\u65B9\u516D\u89D2\u4EAD"
      description: "\u516D\u89D2\u91CD\u4EAD\u662F\u5728\u516D\u89D2\u4EAD\u57FA\u7840\u4E0A\u53D1\u5C55\u800C\u6765\u7684\u53CC\u5C42\u5C4B\u6A90\uFF08\u91CD\u6A90\uFF09\u4EAD\u5F0F\u5EFA\u7B51,\u6574\u4F53\u9020\u578B\u9AD8\u8038\u633A\u62D4,\u4F53\u91CF\u8F83\u5355\u6A90\u4EAD\u66F4\u5927.\u91CD\u6A90\u7684\u8BBE\u8BA1\u4E0D\u4EC5\u589E\u5F3A\u4E86\u5EFA\u7B51\u7684\u5C42\u6B21\u611F\u4E0E\u6C14\u52BF,\u4E5F\u63D0\u5347\u4E86\u5176\u906E\u9633\u907F\u96E8\u7684\u529F\u80FD\u6027.\u6B64\u7C7B\u4EAD\u5B50\u5E38\u4F5C\u4E3A\u56ED\u6797\u4E2D\u7684\u6807\u5FD7\u6027\u5EFA\u7B51,\u53EF\u4F9B\u4EBA\u767B\u9AD8\u671B\u8FDC\u3001\u4FEF\u77B0\u5168\u666F,\u4E5F\u53EF\u7528\u4F5C\u85CF\u4E66\u3001\u62DC\u6708\u7B49\u7279\u5B9A\u7528\u9014,\u517C\u5177\u89C2\u8D4F\u6027\u4E0E\u5B9E\u7528\u6027."
      image: {fileID: 21300000, guid: a1562692ef8aa1d4cb3b442b52d8d043, type: 3}
  - id: 3
    group: 2
    object_inform:
      name: "\u5782\u82B1\u95E8"
      description: "\u5782\u82B1\u95E8\u662F\u4E2D\u56FD\u4F20\u7EDF\u56DB\u5408\u9662\u3001\u5E9C\u7B2C\u7B49\u5B85\u9662\u4E2D\u5206\u9694\u5185\u5916\u9662\u843D\u7684\u5185\u95E8,\u56E0\u6A90\u4E0B\u60AC\u6311\u6709\u5782\u83B2\u67F1\uFF08\u96D5\u523B\u6210\u82B1\u82DE\u3001\u83B2\u82B1\u7B49\u5F62\u72B6\u7684\u77ED\u67F1\uFF09\u800C\u5F97\u540D.\u5176\u5EFA\u7B51\u5F62\u5236\u534E\u4E3D,\u5E38\u914D\u6709\u96D5\u6881\u753B\u680B\u7B49\u88C5\u9970,\u65E2\u662F\u5B85\u9662\u7A7A\u95F4\u5206\u9694\u7684\u91CD\u8981\u8282\u70B9,\u4E5F\u4F53\u73B0\u4E86\u4F20\u7EDF\u5BB6\u65CF\u201C\u5185\u5916\u6709\u522B\u201D\u7684\u793C\u5236\u89C2\u5FF5,\u662F\u5927\u6237\u4EBA\u5BB6\u201C\u4E8C\u95E8\u4E0D\u8FC8\u201D\u4E2D\u201C\u4E8C\u95E8\u201D\u7684\u5178\u578B\u4EE3\u8868."
      image: {fileID: 21300000, guid: 493f1c9044c8c1b43812538e4d003fd9, type: 3}
  - id: 4
    group: 2
    object_inform:
      name: "\u4EEA\u95E8"
      description: "\u4EEA\u95E8\u662F\u4E2D\u56FD\u53E4\u4EE3\u5B98\u5E9C\u8859\u95E8\u3001\u5927\u578B\u5E9C\u7B2C\u7B49\u5EFA\u7B51\u7EC4\u7FA4\u4E2D,\u4F4D\u4E8E\u4E2D\u8F74\u7EBF\u4E0A\u7684\u7B2C\u4E8C\u9053\u6B63\u95E8,\u662F\u4F53\u73B0\u793C\u4EEA\u89C4\u5236\u4E0E\u8EAB\u4EFD\u7B49\u7EA7\u7684\u91CD\u8981\u5EFA\u7B51.\u5176\u5F62\u5236\u5E84\u91CD\u5A01\u4E25,\u591A\u91C7\u7528\u5BF9\u79F0\u5E03\u5C40,\u88C5\u9970\u98CE\u683C\u6C89\u7A33\u5927\u6C14,\u4E3B\u8981\u7528\u4E8E\u8FCE\u63A5\u8D35\u5BBE\u3001\u4E3E\u884C\u91CD\u8981\u4EEA\u5F0F\u7B49\u573A\u5408,\u65E2\u662F\u7A7A\u95F4\u529F\u80FD\u5212\u5206\u7684\u754C\u9650,\u4E5F\u76F4\u89C2\u5F70\u663E\u4E86\u5EFA\u7B51\u4E3B\u4EBA\u7684\u5730\u4F4D\u4E0E\u5A01\u4E25."
      image: {fileID: 21300000, guid: 6d7e337cd5a77c6499841302830740cd, type: 3}
